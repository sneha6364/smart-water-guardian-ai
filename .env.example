# AI-Powered Smart Water Guardian — Environment Configuration
# Copy this file to .env and fill in real values.
# NEVER commit .env to source control.

# ── Groq AI ────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
# Supported models (pick one):
#   llama3-8b-8192
#   llama3-70b-8192
#   mixtral-8x7b-32768
#   gemma2-9b-it
GROQ_MODEL=llama3-8b-8192

# ── Application ────────────────────────────────────────────
APP_ENV=development
# Set to "demo" to run without real API keys
# APP_ENV=demo

# ── Database ───────────────────────────────────────────────
DATABASE_URL=sqlite:///./smart_water.db

# ── Frontend origin (for CORS) ─────────────────────────────
FRONTEND_ORIGIN=http://localhost:5173

# ── Weather API ────────────────────────────────────────────
WEATHER_API_BASE_URL=https://api.open-meteo.com/v1/forecast

# ── Optional: IBM Langflow / watsonx Orchestrate ───────────
# Leave blank unless your hackathon mandates IBM workflow integration.
# LANGFLOW_API_URL=
# LANGFLOW_API_KEY=
